# =============================================================================
# On Call Network — environment variables
# =============================================================================
# Copy this file to .env.local for local development, and configure the same
# keys in your Vercel project for production.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser; everything
# else is server-only.

# -----------------------------------------------------------------------------
# Airtable — form submissions are written to Airtable
# -----------------------------------------------------------------------------
AIRTABLE_API_KEY=pat_your_airtable_personal_access_token
AIRTABLE_BASE_ID=app_your_airtable_base_id
AIRTABLE_VENUE_TABLE=Venue Contacts
AIRTABLE_CANDIDATE_TABLE=Candidate Applications

# -----------------------------------------------------------------------------
# Resend — transactional email (confirmations + internal notifications)
# -----------------------------------------------------------------------------
# Leave unset to disable email sending (form submissions still succeed).
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=On Call Network <hello@oncallnetwork.com.au>
RESEND_REPLY_TO=hello@oncallnetwork.com.au
RESEND_NOTIFY_TO=hello@oncallnetwork.com.au

# -----------------------------------------------------------------------------
# Cloudflare Turnstile — human-check on public forms
# -----------------------------------------------------------------------------
# Leave both unset to skip the challenge (form still protected by honeypot +
# rate limit).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0xAAAAAAAA_your_turnstile_site_key
TURNSTILE_SECRET_KEY=0xAAAAAAAA_your_turnstile_secret_key

# -----------------------------------------------------------------------------
# Microsoft Clarity — session replay + heatmaps (optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id

# -----------------------------------------------------------------------------
# Plausible Analytics — GDPR-friendly analytics (optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=oncallnetwork.com.au

# -----------------------------------------------------------------------------
# Deployment base URL — used for canonical links, OG tags, and sitemap
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://oncallnetwork.com.au

# -----------------------------------------------------------------------------
# Vercel Blob — candidate file uploads (CV + RSA certificate)
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_read_write_token

# -----------------------------------------------------------------------------
# CV service ("Australian CV Rewrite") — payment gate + AI draft
# -----------------------------------------------------------------------------
# Stripe restricted key, read-only on "Checkout Sessions". Use the key from the
# Stripe account that owns the CV Payment Link.
STRIPE_SECRET_KEY=rk_live_your_restricted_key
# Optional: only sessions from this Payment Link unlock the form (plink_...)
STRIPE_CV_PAYMENT_LINK_ID=plink_your_cv_payment_link_id
# Tally form id for the order form + signing secret from Tally -> Integrations -> Webhooks
TALLY_CV_FORM_ID=6DDe4O
TALLY_SIGNING_SECRET=your_tally_webhook_signing_secret
# Claude API key used to draft CVs (drafts are emailed to RESEND_NOTIFY_TO for review)
ANTHROPIC_API_KEY=sk-ant-your_key
